{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Text Aquarium",
  "version": "1.0.0",
  "identifier": "app.textaquarium.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5183",
    "frontendDist": "../src",
    "beforeDevCommand": "node scripts/dev-server.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "tank",
        "title": "Text Aquarium",
        "width": 760,
        "height": 480,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "center": true,
        "backgroundColor": "#FFFFFF",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-backgrounding-occluded-windows --disable-renderer-backgrounding"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
